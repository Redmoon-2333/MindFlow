{
  "name": "frontend",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "lint": "oxlint",
    "preview": "vite preview",
    "generate:api": "uv run --project ../backend-next --no-sync python ../backend-next/scripts/export_openapi.py src/generated/openapi.json && openapi-typescript src/generated/openapi.json -o src/generated/api-schema.ts && node -e \"require('node:fs').unlinkSync('src/generated/openapi.json')\"",
    "check:api-drift": "npx tsx tests/api-schema-drift.test.ts"
  },
  "dependencies": {
    "@emotion/react": "^11.14.0",
    "@emotion/styled": "^11.14.1",
    "@mui/icons-material": "^6.5.0",
    "@mui/lab": "^6.0.0-beta.32",
    "@mui/material": "^6.5.0",
    "@mui/x-date-pickers": "^7.29.4",
    "dayjs": "^1.11.23",
    "openapi-fetch": "^0.17.0",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "react-router-dom": "^7.18.1"
  },
  "devDependencies": {
    "@playwright/test": "^1.62.0",
    "@types/node": "^24.13.2",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.3",
    "openapi-typescript": "^7.13.0",
    "oxlint": "^1.71.0",
    "sass": "^1.105.0",
    "typescript": "~5.9.3",
    "vite": "^8.1.1"
  }
}
